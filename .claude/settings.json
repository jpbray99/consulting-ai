{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/jpbray/Documents/Claude/consulting-ai/.claude/hooks/dod-guard.py record",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/jpbray/Documents/Claude/consulting-ai/.claude/hooks/dod-guard.py check",
            "timeout": 10,
            "statusMessage": "Checking Definition of Done"
          }
        ]
      }
    ]
  }
}
